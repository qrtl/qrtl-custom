<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_source_type_view_tree" model="ir.ui.view">
        <field name="name">module.source.type.view.tree</field>
        <field name="model">module.source.type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
            </tree>
        </field>
    </record>
    <record id="module_source_type_view_form" model="ir.ui.view">
        <field name="name">module.source.type.view.form</field>
        <field name="model">module.source.type</field>
        <field name="arch" type="xml">
            <form>
                <field name="active" invisible="1" />
                <widget
                    name="web_ribbon"
                    title="Archived"
                    bg_color="text-bg-danger"
                    attrs="{'invisible': [('active', '=', True)]}"
                />
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="code" />
                        <field name="sequence" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="module_source_type_view_search" model="ir.ui.view">
        <field name="name">module.source.type.view.search</field>
        <field name="model">module.source.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="code" />
                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active','=',False)]"
                />
            </search>
        </field>
    </record>
    <record id="module_source_type_action" model="ir.actions.act_window">
        <field name="name">Source Types</field>
        <field name="res_model">module.source.type</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="module_source_type_view_search" />
    </record>
</odoo>
