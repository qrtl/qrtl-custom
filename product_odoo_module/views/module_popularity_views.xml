<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_module_popularity_tree" model="ir.ui.view">
        <field name="name">module.popularity.tree</field>
        <field name="model">module.popularity</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="factor" />
            </tree>
        </field>
    </record>
    <record id="view_module_popularity_form" model="ir.ui.view">
        <field name="name">module.popularity.form</field>
        <field name="model">module.popularity</field>
        <field name="arch" type="xml">
            <form string="Module Popularity">
                <field name="active" invisible="1" />
                <widget
                    name="web_ribbon"
                    title="Archived"
                    bg_color="text-bg-danger"
                    attrs="{'invisible': [('active', '=', True)]}"
                />
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="sequence" />
                        <field name="factor" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_module_popularity" model="ir.actions.act_window">
        <field name="name">Module Popularity</field>
        <field name="res_model">module.popularity</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
