<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_category_product_odoo_module" model="ir.module.category">
        <field name="name">Odoo Module Registry</field>
        <field name="sequence">30</field>
    </record>
    <record id="group_product_odoo_module_manager" model="res.groups">
        <field name="name">Odoo Module Manager</field>
        <field name="category_id" ref="module_category_product_odoo_module" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>
    <record id="customer_module_info_comp_rule" model="ir.rule">
        <field name="name">Customer Module Info: multi-company</field>
        <field name="model_id" ref="model_customer_module_info" />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
