<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_server_server_search" model="ir.ui.view">
        <field name="name">server.server.search</field>
        <field name="model">server.server</field>
        <field name="arch" type="xml">
            <search string="Servers">
                <field name="name" />
                <field name="partner_id" />
                <filter
                    string="Active"
                    name="active"
                    domain="[('active', '=', True)]"
                />
                <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active', '=', False)]"
                />
                <group expand="0" string="Group By">
                    <filter
                        string="Customer"
                        name="group_partner"
                        context="{'group_by': 'partner_id'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="view_server_server_tree" model="ir.ui.view">
        <field name="name">server.server.tree</field>
        <field name="model">server.server</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name" />
                <field name="partner_id" />
                <field name="url" widget="url" />
                <field name="info" />
                <field
                    name="tags"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                />
                <field name="active" widget="boolean_toggle" />
            </tree>
        </field>
    </record>
    <record id="action_server_server" model="ir.actions.act_window">
        <field name="name">Servers</field>
        <field name="res_model">server.server</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_server_server_tree" />
    </record>
</odoo>
