<?xml version="1.0" ?>
<odoo>
    <record id="remote_server_tag_view_tree" model="ir.ui.view">
        <field name="name">remote.server.tag.view.tree</field>
        <field name="model">remote.server.tag</field>
        <field name="arch" type="xml">
            <tree string="Remote Server Tags" editable="top">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="color" widget="color_picker" />
            </tree>
        </field>
    </record>
    <record id="remote_server_tag_action" model="ir.actions.act_window">
        <field name="name">Remote Server Tags</field>
        <field name="res_model">remote.server.tag</field>
        <field name="view_mode">tree</field>
    </record>
    <menuitem
        id="menu_remote_server_tag"
        name="Remote Server Tags"
        parent="menu_remote_server_config"
        action="remote_server_tag_action"
        sequence="3"
    />
</odoo>
