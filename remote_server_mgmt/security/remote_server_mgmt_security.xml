<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.module.category" id="module_category">
        <field name="name">Remote Servers</field>
    </record>
    <record id="group_remote_server_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category" />
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
    </record>
    <record id="group_remote_server_officer" model="res.groups">
        <field name="name">Officer</field>
        <field name="category_id" ref="module_category" />
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_remote_server_user'))]"
        />
    </record>
    <record id="group_remote_server_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category" />
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_remote_server_officer'))]"
        />
        <field
            name="users"
            eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"
        />
    </record>
</odoo>
