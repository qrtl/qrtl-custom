<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="portal_my_task_hide_timesheets"
        inherit_id="hr_timesheet.portal_my_task"
        name="Portal: My Task without Timesheets"
    >
        <xpath expr="//t[@t-set='show_portal_timesheets']" position="after">
            <t t-set="show_portal_timesheets" t-value="False" />
        </xpath>
    </template>
</odoo>
